+def to_uuid(sid):
+    """SaveJogo.sid é Uuid(as_uuid=True): sempre converter str -> uuid.UUID antes de consultar."""
+    if isinstance(sid, uuid.UUID):
+        return sid
+    try:
+        return uuid.UUID(str(sid))
+    except (ValueError, TypeError, AttributeError):
+        return None
+
