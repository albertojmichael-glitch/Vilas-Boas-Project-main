diff --git a/tests/test_ia_perseguidor.py b/tests/test_ia_perseguidor.py
new file mode 100644
index 0000000..07f5363
--- /dev/null
+++ b/tests/test_ia_perseguidor.py
@@ -0,0 +1,116 @@
+import random
+
+import pytest
+
+import villas_boas.engine.core as core
+from state import GameState
+from test_devmode import UIGravador  # UI de teste que só grava a saída
+
+TERMINAIS = {"morte", "saida", "cama", "final_bom"}
+
+
+@pytest.fixture
+def jogo():
+    j = GameState(ui_handler=UIGravador())
+    j.estado_atual, j.sala_atual, j.dificuldade_escolhida = "JOGO", "entrada", "NORMAL"
+    return j
+
+
+@pytest.fixture
+def chamadas_ia(monkeypatch):
+    chamadas = []
+    original = core.processar_ia_inimigo
+    monkeypatch.setattr(core, "processar_ia_inimigo", lambda j: (chamadas.append(j.sala_atual), original(j)))
+    return chamadas
+
+
+def test_ir_bem_sucedido_roda_a_ia(jogo, chamadas_ia):
+    core.processar_fluxo_jogo("ir frente", jogo)
+    assert jogo.sala_atual != "entrada"
+    assert len(chamadas_ia) == 1  # antes do fix: 0
+
+
+def test_atalho_de_direcao_faz_o_mesmo_barulho_que_ir(jogo):
+    core.processar_fluxo_jogo("f", jogo)
+    assert jogo.nivel_barulho == 10  # +15 de movimento, -5 de decaimento da IA
+
+
+def test_olhar_reduz_barulho(jogo):
+    jogo.nivel_barulho = 40
+    core.processar_fluxo_jogo("inventario", jogo)
+    assert jogo.nivel_barulho == 25  # -10 do comando, -5 da IA
+
+
+def test_perseguidor_caca_e_alcanca_o_jogador(jogo):
+    jogo.ai_sala, jogo.nivel_barulho = "sala de jantar", 100  # vizinha da entrada
+    core.processar_fluxo_jogo("inventario", jogo)
+    assert jogo.estado_atual == "COMBATE_ANIMATRONICO"
+    core.processar_fluxo_jogo("olhar", jogo)  # sem god mode, reagir não adianta
+    assert jogo.estado_atual == "FIM" and jogo.sala_atual == "morte"
+
+
+def test_aviso_de_passos_quando_ele_esta_ao_lado(jogo):
+    jogo.ai_sala, jogo.nivel_barulho = "sala de jantar", 0
+    jogo.ui_handler.buffer.clear()
+    random.seed(1)
+    core.processar_ia_inimigo(jogo)
+    assert any("passos" in b for b in jogo.ui_handler.buffer) or jogo.ai_sala != "sala de jantar"
+
+
+def test_comando_que_abre_minigame_nao_gasta_turno_da_ia(jogo, chamadas_ia):
+    jogo.sala_atual = "sala de energia"  # qualquer comando abre o minigame do minotauro
+    core.processar_fluxo_jogo("olhar", jogo)
+    assert jogo.estado_atual.startswith("MINIGAME")
+    assert chamadas_ia == []
+
+
+def test_ia_nunca_patrulha_para_salas_terminais(jogo):
+    sala_com_saida_letal = next(
+        nome for nome, sala in jogo.mapa.items()
+        if isinstance(sala, dict) and any(v in TERMINAIS for v in sala.values() if isinstance(v, str))
+    )
+    random.seed(7)
+    for _ in range(400):
+        jogo.ai_sala, jogo.nivel_barulho, jogo.sala_atual = sala_com_saida_letal, 0, "entrada"
+        jogo.estado_atual = "JOGO"
+        core.processar_ia_inimigo(jogo)
+        assert jogo.ai_sala not in TERMINAIS
+
+
+def test_perseguidor_continua_se_movendo_em_partida_longa(jogo):
+    random.seed(3)
+    visitadas = set()
+    for _ in range(200):
+        jogo.sala_atual, jogo.nivel_barulho, jogo.estado_atual = "entrada", 0, "JOGO"
+        core.processar_ia_inimigo(jogo)
+        visitadas.add(jogo.ai_sala)
+    assert len(visitadas) > 5 and not (visitadas & TERMINAIS)
+
+
+def test_god_mode_continua_com_ia_congelada(jogo):
+    jogo.god_mode, jogo.ai_sala, jogo.nivel_barulho = True, "palco", 100
+    for _ in range(5):
+        core.processar_fluxo_jogo("inventario", jogo)
+    assert jogo.ai_sala == "palco"
+
+
+def test_correr_continua_sem_rodar_a_ia_no_mesmo_turno(jogo, chamadas_ia):
+    core.processar_fluxo_jogo("correr frente", jogo)
+    assert chamadas_ia == []
+    assert jogo.nivel_barulho == 100
+
+
+def test_fluxo_normal_executa_comandos_com_modo_dev_desligado(jogo):
+    """Regressão: processar_fluxo_jogo já ficou sem a chamada ao fluxo normal e ignorava tudo."""
+    assert not jogo.dev_mode
+    core.processar_fluxo_jogo("ir frente", jogo)
+    assert jogo.sala_atual == "sala de jantar"
+
+
+@pytest.mark.parametrize("dificuldade", ["NORMAL", "PESADELO"])
+def test_eventos_de_tempo_nao_quebram_nas_dificuldades(jogo, dificuldade):
+    """Regressão: perseguidores por tempo estavam duplicados e recebiam None."""
+    jogo.dificuldade_escolhida = dificuldade
+    for cmd in ["ir frente", "ir atrás", "inventario", "ir frente"]:
+        core.processar_fluxo_jogo(cmd, jogo)
+    assert jogo.estado_atual in ("JOGO", "COMBATE_ANIMATRONICO", "FIM")
